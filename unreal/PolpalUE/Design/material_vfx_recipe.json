  "materials": {
    "M_PalToon": {
      "editor_script": "Content/Python/bootstrap_project.py prepares the graph, element instances and generated mesh assignment; UE5 execution and shader compilation remain unverified.",
      "shading_model": "Unlit",
      "expression": "EmissiveColor = ElementBaseColor * ThreeTone(Clamp(Dot(PixelNormalWS, normalize(LightDirection)),0,1)) * VertexColor.R",
      "parameters": {
        "LightDirection": "world-space vector set by gameplay/editor",
        "ElementBaseColor": "vector per element",
        "ShadowTone": 0.38,
        "MidTone": 0.7,
        "LightTone": 1.0,
        "Threshold1": 0.35,
        "Threshold2": 0.7
      },
      "vertex_mask": "R multiplies shade; default 1. Imported prototype mesh color layer is ElementMask."
    },
    "M_PalOutline": {
      "shading_model": "Unlit",
      "rendering": "Unlit one-sided outline material applied to imported reversed-face skeletal hull; APalCharacter follows main mesh using leader pose. UE visual verification pending.",
      "expression": "WorldPositionOffset = VertexNormalWS * VertexColor.G * -0.5 cm; black emissive.",
      "parameters": {
        "OutlineColor": [
          0.025,
          0.025,
          0.04
        ],
        "extrusion_cm": -0.5
      },
      "vertex_mask": "G scales outline width; prototype default 0.5."
    },
    "limitation": "A parameter-lit Unlit toon material does not receive scene directional shadows or Lumen reflections as a Default Lit surface. It requires an explicit LightDirection update and separate shadow strategy."
  },
